# RouteNex v3 configuration. Copy to .env (never commit real secrets).
# Local development defaults are demo-friendly; production/staging FAIL CLOSED unless every required value is set.

APP_ENV=development                       # development | test | staging | production
BASE_URL=http://localhost:8000            # must be HTTPS in production/staging
DATABASE_URL=postgresql+psycopg://routenex:routenex@localhost:5432/routenex
TEST_DATABASE_URL=postgresql+psycopg://routenex:routenex@localhost:5432/routenex_test
SECRET_KEY=                               # 32+ random chars; REQUIRED in production/staging

# Demo shortcuts — all three MUST be false in production/staging.
DEMO_MODE=true
DEMO_AUTOPILOT=true
SEED_DEMO_DATA=true

# Administrator bootstrap (created if missing; password rotated only with --rotate-admin-password).
ADMIN_NAME=Sami Khan
ADMIN_EMAIL=samikhan@gmail.com
ADMIN_PASSWORD=                           # unique, 12+ chars, not a demo password; REQUIRED in production

# Payments. Production requires razorpay + all three credentials.
PAYMENT_PROVIDER=demo                     # demo | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESERVATION_MINUTES=15

# OTP delivery. Production requires twilio.
OTP_PROVIDER=console                      # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Places / routing / maps.
LOCATION_PROVIDER=local                   # local | photon | geoapify
PHOTON_URL=
GEOAPIFY_API_KEY=
ROUTING_URL=https://router.project-osrm.org
TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
WEATHER_ENABLED=true

# Browser security.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,*.e2b.app
SESSION_HOURS=12
SESSION_IDLE_MINUTES=60

# Optional assistant / ML.
LLM_PROVIDER=offline                      # offline | ollama | gemini | auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ML_AUTOTRAIN=false
LOG_LEVEL=INFO

# Docker compose only:
POSTGRES_PASSWORD=
