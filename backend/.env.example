# Copy to backend/.env  (it is now actually loaded by config.py)
ROUTENEX_ENV=development            # set to production when deploying (then SECRET must be 32+ chars)
ROUTENEX_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ROUTENEX_DB=../database/routenex.db
ACCESS_TOKEN_MINUTES=60
DEMO_MODE=true                      # demo OTP 123456 for DEMO_PHONE + demo Google profile; turn off for real use
DEMO_AUTOPILOT=true                 # simulated drivers move + finish trips by themselves; set false to drive trips manually from a driver login
DEMO_PHONE=8882846897
OTP_PROVIDER=console
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- Assistant (all optional; with nothing set it runs in built-in offline mode) ----
LLM_PROVIDER=auto                   # auto | ollama | gemini | offline
OLLAMA_MODEL=qwen2.5:3b             # use qwen2.5:1.5b if your laptop has little free RAM
OLLAMA_HOST=http://127.0.0.1:11434
GEMINI_API_KEY=                     # free key from aistudio.google.com (optional)
GEMINI_MODEL=gemini-flash-latest

# ---- Owner / admin login (created or updated automatically on every start) ----
# Put your real password ONLY in your private backend/.env and in Render's Environment tab, never in a file you commit.
# Avoid spaces and the # character in the password. Until it is set, nobody can log in as admin.
ADMIN_NAME=Sami Khan
ADMIN_EMAIL=samikhan@routenex.in
ADMIN_PASSWORD=
